# Connexion PostgreSQL Supabase - Shared Pooler
# Remplacer les valeurs fictives par les vraies informations dans infra/.env
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:CHANGE_ME@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require

# Sécurité JWT : générer une clé aléatoire pour l'environnement local
JWT_SECRET_KEY=CHANGE_ME

# Durée des cookies de session : access token 15 min, refresh token 30 jours.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# URL API du frontend public (vide pour utiliser le proxy Nginx)
VITE_API_URL=

# URLs des deux applications, utilisées pour les redirections selon le rôle.
VITE_ADMIN_URL=http://localhost:8081
VITE_PUBLIC_URL=http://localhost:8080

# Origines autorisées pour CORS et les requêtes authentifiées par cookie.
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:5173,http://localhost:5174

# false en HTTP local ; activer en production avec HTTPS.
AUTH_COOKIE_SECURE=false