# Connexion PostgreSQL Supabase - Shared Pooler
# Remplacer les valeurs fictives par les vraies informations dans infra/.env
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:CHANGE_ME@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require

# Sécurité JWT : générer une clé aléatoire pour l'environnement local
JWT_SECRET_KEY=CHANGE_ME

# URL API du frontend public (vide pour utiliser le proxy Nginx)
VITE_API_URL=