# --- Variables de l'API (copier ce fichier en .env ; .env n'est JAMAIS versionné) ---

# Base PostgreSQL. Avec Supabase : Project Settings > Database > Connection string,
# en remplaçant le préfixe « postgresql:// » par « postgresql+psycopg:// ».
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/DevopsProject

# Origines autorisées à appeler l'API (CORS), séparées par des virgules :
# frontend-public (5173) et frontend-admin (5174) en développement.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Secret de signature des JWT : générer une valeur aléatoire longue
# (ex. : python -c "import secrets; print(secrets.token_urlsafe(48))").
JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=30
